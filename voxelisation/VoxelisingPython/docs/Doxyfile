# Doxyfile for the UD-IArbre voxeliser (Python package voxelizer/).
# Build from VoxelisingPython/docs with: doxygen Doxyfile   (or make_docs.cmd / make_docs.sh)
# Output: docs/doxygen/html/index.html. Requires Doxygen >= 1.9.2 (Python docstrings) and Graphviz (dot).

PROJECT_NAME           = "UD-IArbre Voxelizer"
PROJECT_BRIEF          = "Voxelisation LiDAR par colonnes de plages : structure, pipeline, sorties"
PROJECT_NUMBER         = "2026-09"
OUTPUT_DIRECTORY       = doxygen
OUTPUT_LANGUAGE        = French
CREATE_SUBDIRS         = NO

INPUT                  = ../voxelizer ../../ARCHITECTURE.md groups.dox ../HowToUse.md ../ExecutionSteps.md ../ReadMEs/Voxelizer-Documentation.md ../ReadMEs/cli_and_bat_reference.md ../ReadMEs/laz_roundtrip_design.md ../ReadMEs/visualizer3d_workflow.md ../ReadMEs/single_vs_all_workflows.md ../ReadMEs/columns_gridding_voxels.md ../ReadMEs/points_vs_intervals.md ../ReadMEs/pipeline_py_explanation.md ../ReadMEs/las_1_2_vs_1_4_classification.md ../ReadMEs/12_workflow_schema.md ../ReadMEs/02_visualization_formats.md
FILE_PATTERNS          = *.py *.md *.dox
RECURSIVE              = NO
EXCLUDE_PATTERNS       = */__pycache__/*
IMAGE_PATH             = ../ReadMEs ../Diagrams
USE_MDFILE_AS_MAINPAGE = ../../ARCHITECTURE.md
STRIP_FROM_PATH        = .. ../..

# Python: docstrings are the documentation, everything is extracted
OPTIMIZE_OUTPUT_JAVA   = YES
PYTHON_DOCSTRING       = NO      # docstrings parsed as documentation, not verbatim text
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
SHOW_NAMESPACES        = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
SORT_MEMBER_DOCS       = NO
WARN_NO_PARAMDOC       = NO
TOC_INCLUDE_HEADINGS   = 4
MARKDOWN_ID_STYLE      = GITHUB
ALWAYS_DETAILED_SEC    = YES
REPEAT_BRIEF           = YES
BRIEF_MEMBER_DESC      = YES
SORT_GROUP_NAMES       = NO
SORT_MEMBERS_CTORS_1ST = YES
SORT_BRIEF_DOCS        = NO
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
FULL_PATH_NAMES        = YES

# Graphs (Graphviz): class, collaboration, call and caller graphs, module dependencies
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DIRECTORY_GRAPH        = YES
GRAPHICAL_HIERARCHY    = YES
DOT_GRAPH_MAX_NODES    = 120
MAX_DOT_GRAPH_DEPTH    = 0
DOT_CLEANUP            = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_LOGFILE           = doxygen_warnings.log
